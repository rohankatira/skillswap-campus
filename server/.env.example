# =============================================
# SkillSwap Campus — Server environment variables
# =============================================
# Copy this file to .env for local dev.
# In Render: set these in the Web Service's environment settings.

# MongoDB Atlas connection string (get from Atlas → Connect → Drivers)
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/skillswap?retryWrites=true&w=majority

# URL of this server as Render will expose it (used by Better Auth)
BETTER_AUTH_URL=https://your-server-name.onrender.com

# Random secret string — generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
BETTER_AUTH_SECRET=replace_with_a_long_random_secret

# URL of the deployed React frontend (used for CORS)
CLIENT_ORIGIN=https://your-client-name.onrender.com

# Port — Render sets this automatically; leave as 5000 for local dev
PORT=5000
